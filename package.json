{
  "name": "oms-backoffice-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "start": "bash scripts/serve.sh",
    "dev:vite": "ulimit -n 65536 2>/dev/null; vite --strictPort",
